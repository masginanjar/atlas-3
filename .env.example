# ===== Frontend (Vite) — kosongkan VITE_INSFORGE_URL untuk MODE DEMO (data di browser) =====
VITE_INSFORGE_URL=https://xxxx.region.insforge.app
VITE_INSFORGE_ANON_KEY=
# true = pakai data Zoho asli walau InsForge belum diisi (untuk tes awal; jangan bagikan link sebelum InsForge aktif)
VITE_ZOHO_LIVE=false

# ===== Server (Vercel Functions) — JANGAN diberi prefix VITE_ =====
INSFORGE_URL=https://xxxx.region.insforge.app

# Zoho Books (OAuth Self Client)
ZOHO_DC=com                 # com | eu | in | com.au | jp | sa
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=

# Google Drive (OAuth refresh token akun Google pemilik folder)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
